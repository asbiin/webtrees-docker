# Copy this file to .env and fill in the values. WEBTREES_DOMAIN and ACME_EMAIL
# are required; the others keep their default when left empty.

# Public name of the site. Its DNS record must point to this server.
WEBTREES_DOMAIN=tree.example.com
# Let's Encrypt sends certificate expiry notices to this address
ACME_EMAIL=admin@example.com

# Default language of the site: en-US, en-GB, fr, de, nl...
WEBTREES_LANGUAGE=en-US

# Password of the webtrees database user (default: webtrees)
DB_PASSWORD=

# Initial administrator, created on the very first start only. WT_PASS defaults
# to changeme: set it, as the site is public.
WT_USER=admin
WT_NAME=Administrator
WT_PASS=
WT_EMAIL=admin@example.com
